<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="View_Files">
        <control type="group">
            <visible>Control.IsVisible(50) + [Container.Content(files) | Container.Content(videos) | Container.Content(images) | Container.Content(none)] + ![Container.Content(music)]</visible>
            <include>FullScreen</include>
            <control type="group">
                <include>R 1/3 Panel</include>
                <include>bg</include>
                <control type="grouplist">    
                    <top>840</top>
                    <left>10</left>     
                    <itemgap>-100</itemgap>    
                <control type="label">
                    <left>10</left>
                    <top>10</top>
                    <width>600</width>
	                <visible>!String.IsEmpty(ListItem.Duration)</visible>
                    <textcolor>white</textcolor>
                    <align>center</align>
                    <height>100</height>
                    <label>[COLOR button_focus]Runtime : [/COLOR]$INFO[ListItem.Duration]</label>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>10</top>
                    <width>600</width>
	                <visible>!String.IsEmpty(ListItem.Size)</visible>
                    <textcolor>white</textcolor>
                    <align>center</align>
                    <height>100</height>
                    <label>[CR][COLOR button_focus]Size : [/COLOR]$INFO[ListItem.Size]</label>
                </control>
            </control>   
                <control type="image" id="32112"><!--thumb-->
                    <height>75%</height>
                    <left>10</left>
                    <right>10</right>
                    <aspectratio>keep</aspectratio>
                    <texture fallback="DefaultNoPreview.png">$VAR[ShiftThumbVar]</texture>
                    <animation effect="slide" end="160,0" time="0" condition="Container.Content(videos) | Container.Content(images) | Container.Content(none)">conditional</animation>
                    <animation effect="zoom" start="100" end="50" time="0" condition="Container.Content(videos) | Container.Content(images) | Container.Content(none)">conditional</animation>
                </control>
                <control type="group">
                    <top>37.5%</top>
                    <bottom>0.5%</bottom>
                    <include>plottext</include>
                </control>
                <control type="group">
                    <bottom>2%</bottom>
                    <include>mediaflags</include>
                </control>         
            </control>
        </control>
    </include>
</includes>