<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<controls>
		<control type="group">
			<width>100%</width>
					<height>21.25%</height>
					<top>851</top>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<control type="group">
				<depth>DepthOSD</depth>
				<include>Keyboard_Slide_Up</include>
				<control type="image">
					<top>-1120</top>
					<texture colordiffuse="button_focus">panels/videoosd.png</texture>
				</control>
				<control type="image"> <!-- Static channel logo for focused item -->
					<left>79%</left>> <!-- Adjust position -->
					<top>2.5%</top> <!-- Adjust position -->
					<width>20%</width>
					<height>95%</height>
					<align>bottomright</align>
					<aspectratio aligny="bottomleft">keep</aspectratio>
					<texture>$INFO[ListItem.ActualIcon]</texture>
					<visible>Control.HasFocus(11)</visible> 
				</control>
				<control type="fixedlist" id="11">
					<left>-5</left>
					<top>5</top>
					<width>1500</width>
					<bottom>5</bottom>
					<onleft>PreviousChannelGroup</onleft>
					<onright>NextChannelGroup</onright>
					<onup>11</onup>
					<ondown>11</ondown>
					<movement>4</movement>
					<focusposition>4</focusposition>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">500</scrolltime>
				
					<itemlayout height="44" infoupdate="0">
				<control type="label">
					<left>10</left>
					<top>-2</top>
					<width>90</width>
					<height>50</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font32_title</font>
					
					<label>[COLOR grey]$INFO[ListItem.ChannelNumberLabel][/COLOR]</label>
				</control>
				
						<control type="label">
				<left>130</left>
				<top>0</top>
				<width>570</width>
				<font>font36_title</font>
				<aligny>center</aligny>
			
				<label>$INFO[ListItem.Label]</label>
			</control>
			
		
				<control type="label">
					<left>730</left>
					<width>765</width>
					<top>4</top>
					<height>30</height>
					<font>font12</font>
					<aligny>top</aligny>
					<label>[COLOR grey]$VAR[PVRListItemSubLabel][/COLOR]</label>
				</control>
			</itemlayout>
			<focusedlayout height="44" infoupdate="0">
				<control type="image">
					<left>10</left>
					<top>0</top>
					<right>0</right>
					<height>42</height>
					<animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
					<texture colordiffuse="button_focus" border="10,10,10,10">lists/menulist.png</texture>
				
				</control>
			<control type="label">
					<left>10</left>
					<top>-2</top>
					<width>90</width>
					<height>50</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font32_title</font>
					
					<label>$INFO[ListItem.ChannelNumberLabel]</label>
				</control>
				
						<control type="label">
				<left>130</left>
				<top>0</top>
				<width>570</width>
				<font>font36_title</font>
				<aligny>center</aligny>
			
				<label>$INFO[ListItem.Label]</label>
			</control>
			

				<control type="label">
					<left>730</left>
					<width>765</width>
					<top>4</top>
					<height>30</height>
					<font>font12</font>
					<aligny>top</aligny>
					<label>$VAR[PVRListItemSubLabel]</label>
				</control>
			</focusedlayout>
				</control>

		
				
			</control>
		</control>
	
	</controls>
</window>
