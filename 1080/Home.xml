<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="String.IsEmpty(Skin.String(ppi_layout))">Skin.SetString(ppi_layout,1)</onload>
	<onload condition="String.IsEmpty(Skin.String(tv_layout))">Skin.SetString(tv_layout,1)</onload>
	<onload condition="String.IsEmpty(Skin.String(home_layout))">Skin.SetString(home_layout,2)</onload>
	<onload condition="String.IsEmpty(Skin.String(grid_layout))">Skin.SetString(grid_layout,6)</onload>
	<defaultcontrol>1000</defaultcontrol>
	<controls>
		<include>HomeLoad</include>
		<include>DefaultBGNSB</include>
		<control type="group" id="100">
			<include>DA</include>			
			<control type="group" id="101">
				<animation effect="fade" start="100" end="0" time="0" condition="Player.HasVideo + Control.HasFocus(1000)">Conditional</animation>
				<include>FavoritesPanel</include>
				<include>MusicPanel</include>
				<include>AddonPanel</include>
				<include condition="String.IsEqual(Skin.String(tv),2) | String.IsEqual(Skin.String(tv),3)">TVPanel</include>
				<include>VideoPanel</include>
				<include condition="String.IsEqual(Skin.String(home_layout),2)">POVFlixPanel</include>
				<include condition="String.IsEqual(Skin.String(home_layout),3)">POVRowPanel</include>
				<include condition="String.IsEqual(Skin.String(home_layout),4)">POVListPanel</include>
			</control>
			<include>HomePanel</include>
			<include>HomeMouseMenu</include>
		</control>
	</controls>
</window>