<?xml version="1.0" encoding="utf-8"?>
<includes>

	<!-- MPAA UK Icons -->
    <include name="MPAA_Details_RowNew">
	<include>DA</include>
	<!-- Icon display -->
		<control type="image">
	<visible>!String.IsEmpty(ListItem.Mpaa)</visible>
			<top>7</top>
			<width>35</width>
			<height>35</height>
            <aspectratio>keep</aspectratio>
			<texture>$VAR[mediaflags_large_rating_UK_icons]</texture>
			<include>DA</include>
        </control>
    </include>
	<variable name="mediaflags_text">
		<value condition="String.Contains(ListItem.Mpaa,UK:U) | String.Contains(ListItem.Mpaa,GB-U) | String.Contains(ListItem.Mpaa,Rated U) | String.IsEqual(ListItem.Mpaa,U) | String.Contains(ListItem.Mpaa,UK:U) | String.Contains(ListItem.Mpaa,GB-U) | String.Contains(ListItem.Mpaa,Rated U) | String.IsEqual(ListItem.Mpaa,U)">Rated-U</value>
		<value condition="String.Contains(ListItem.Mpaa,UK:PG) | String.Contains(ListItem.Mpaa,GB-PG) | String.Contains(ListItem.Mpaa,Guidance) | String.Contains(ListItem.Mpaa,UK:PG) | String.Contains(ListItem.Mpaa,GB-PG) | String.Contains(ListItem.Mpaa,Guidance)">Rated-PG</value>
		<value condition="String.Contains(ListItem.Mpaa,UK:12A) | String.Contains(ListItem.Mpaa,GB-12A) | String.Contains(ListItem.Mpaa,Rated 12A) | String.IsEqual(ListItem.Mpaa,12A) | String.Contains(ListItem.Mpaa,UK:12A) | String.Contains(ListItem.Mpaa,GB-12A) | String.Contains(ListItem.Mpaa,Rated 12A) | String.IsEqual(ListItem.Mpaa,12A)">Rated-12A</value>
		<value condition="String.IsEqual(ListItem.Mpaa,UK:12) | String.IsEqual(ListItem.Mpaa,GB-12) | String.IsEqual(ListItem.Mpaa,Rated 12) | String.IsEqual(ListItem.Mpaa,12) | String.IsEqual(ListItem.Mpaa,UK:12) | String.IsEqual(ListItem.Mpaa,GB-12) | String.IsEqual(ListItem.Mpaa,Rated 12) | String.IsEqual(ListItem.Mpaa,12)">Rated-12</value>
		<value condition="String.Contains(ListItem.Mpaa,UK:15) | String.Contains(ListItem.Mpaa,GB-15) | String.Contains(ListItem.Mpaa,Rated 15) | String.IsEqual(ListItem.Mpaa,15) | String.Contains(ListItem.Mpaa,Mature) | String.Contains(ListItem.Mpaa,UK:15) | String.Contains(ListItem.Mpaa,GB-15) | String.Contains(ListItem.Mpaa,Rated 15) | String.IsEqual(ListItem.Mpaa,15) | String.Contains(ListItem.Mpaa,Mature)">Rated-15</value>
		<value condition="String.Contains(ListItem.Mpaa,UK:18) | String.Contains(ListItem.Mpaa,GB-18) | String.Contains(ListItem.Mpaa,Rated 18) | String.IsEqual(ListItem.Mpaa,18) | String.Contains(ListItem.Mpaa,UK:18) | String.Contains(ListItem.Mpaa,GB-18) | String.Contains(ListItem.Mpaa,Rated 18) | String.IsEqual(ListItem.Mpaa,18)">Rated-18</value>
		<!--UK translation of US TV ratings-->
		<value condition="String.IsEqual(ListItem.Mpaa,TV-Y) | String.Contains(ListItem.Mpaa,TV-Y7) | String.Contains(ListItem.Mpaa,TV-G) | String.IsEqual(ListItem.Mpaa,TV-Y) | String.Contains(ListItem.Mpaa,TV-Y7) | String.Contains(ListItem.Mpaa,TV-G)">TV-G</value>
		<value condition="String.Contains(ListItem.Mpaa,TV-PG) | String.Contains(ListItem.Mpaa,TV-PG)">TV-PG</value>
		<value condition="String.Contains(ListItem.Mpaa,TV-14) | String.Contains(ListItem.Mpaa,TV-14)">TV-14</value>
		<value condition="String.Contains(ListItem.Mpaa,TV-MA) | String.Contains(ListItem.Mpaa,TV-MA) | String.Contains(ListItem.Mpaa,USA:TV-MA)">TV-MA</value>		
		<!--UK translation of US MPAA so US can also use UK icons if setting is enabled-->
		<value condition="String.Contains(ListItem.Mpaa,US:G) | String.Contains(ListItem.Mpaa,USA:G) | String.Contains(ListItem.Mpaa,Rated G) | String.IsEqual(ListItem.Mpaa,G) | String.Contains(ListItem.Mpaa,US:G) | String.Contains(ListItem.Mpaa,USA:G) | String.Contains(ListItem.Mpaa,Rated G) | String.IsEqual(ListItem.Mpaa,G)">Rated-G</value>
		<value condition="String.Contains(ListItem.Mpaa,PG-13) | String.Contains(ListItem.Mpaa,PG-13)">PG-13</value>
		<value condition="String.IsEqual(ListItem.Mpaa,US:PG) | String.IsEqual(ListItem.Mpaa,USA:PG) | String.IsEqual(ListItem.Mpaa,Rated PG) | String.IsEqual(ListItem.Mpaa,PG) | String.IsEqual(ListItem.Mpaa,US:PG) | String.IsEqual(ListItem.Mpaa,USA:PG) | String.IsEqual(ListItem.Mpaa,Rated PG) | String.IsEqual(ListItem.Mpaa,PG)">Rated-PG</value> 
		<value condition="String.Contains(ListItem.Mpaa,US:R) | String.Contains(ListItem.Mpaa,USA:R) | String.Contains(ListItem.Mpaa,Rated R) | String.IsEqual(ListItem.Mpaa,R) | String.Contains(ListItem.Mpaa,US:R) | String.Contains(ListItem.Mpaa,USA:R) | String.Contains(ListItem.Mpaa,Rated R) | String.IsEqual(ListItem.Mpaa,R)">Rated-R</value>
		<value condition="String.Contains(ListItem.Mpaa,NC-17) | String.Contains(ListItem.Mpaa,NC-17)">NC-17</value>
		<value>Unrated</value>
	</variable>

	
<!--details row MPAA UK & UK style US icons-->
