			</include>
		<!--Power Menu-->			
			<control type="group"> 
				<onload>Control.SetFocus(902, 0)</onload>	
				<control type="panel" id="902"> 
					<left>10</left>
					<top>118</top>
					<right>10</right>
					<height>600</height>
					<align>center</align>
					<onback>901</onback>
					<onright>901</onright>
					<include>SettingsPanelPowerMenu</include>
					<visible allowhiddenfocus="true">![Control.HasFocus(901) | Control.HasFocus(901) | Control.HasFocus(903) | Control.HasFocus(904) | Control.HasFocus(905) | Control.HasFocus(906) | Control.HasFocus(907)]</visible>
					<content>
						<item>
							<label>Reload skin</label>
							<onclick>ReloadSkin()</onclick>
							<icon>icons/sidemenu/reloadskin2.png</icon>
						</item>
						<item>
							<label>Restart Kodi</label>
							<icon>icons/sidemenu/restartkodi2.png</icon>
							<onclick>RestartApp</onclick>
							<visible>System.CanReboot</visible>
						</item>
						<item>
							<label>$LOCALIZE[13012]</label>
							<icon>icons/sidemenu/exit.png</icon>
							<onclick>Quit()</onclick>
							<visible>System.ShowExitButton</visible>
						</item>
						<item> + <label>Reboot to eMMC/NAND</label>
							<icon>icons/sidemenu/android2.png</icon>
							<onclick>
							System.ExecWait("/usr/sbin/rebootfromnand")</onclick>
							<onclick>Reset()</onclick>
							<visible>
							System.CanReboot + System.AddonIsEnabled(service.coreelec.settings)</visible> + 
						</item>
						<item>
							<label>$LOCALIZE[13013]</label>
							<icon>icons/sidemenu/restart2.png</icon>
							<onclick>Reset()</onclick>
							<visible>System.CanReboot</visible>
						</item>
						<item>
							<label>$LOCALIZE[13016]</label>
							<icon>icons/sidemenu/power2.png</icon>
							<onclick>Powerdown()</onclick>
							<visible>System.CanPowerDown</visible>
						</item>
					</content>
				</control>
				 <control type="label">
					<right>30</right>
					<top>45</top>
					<left>350</left>
					<height>140</height>
