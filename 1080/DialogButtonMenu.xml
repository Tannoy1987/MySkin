					<animation effect="slide" end="-8,0" time="0" condition="Control.HasFocus(903)">conditional</animation>
					<left>133</left>
					<width>500</width>
					<top>118</top>
					<bottom>20%</bottom>
					<onleft>901</onleft>
					<include>SettingsPanelSubMenu</include>
					<content>
						<item>
							<label>Videos</label>
							<onclick>Dialog.Close(all,true)</onclick>
							<onclick>ActivateWindow(videos)</onclick>
							<icon>icons/settings/videofiles.png</icon>
						</item>
						<item>
							<label>Music</label>
							<onclick>Dialog.Close(all,true)</onclick>
