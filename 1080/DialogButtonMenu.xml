		<!--Main Menu-->		
			<control type="panel" id="901">
				<left>10</left>
				<top>118</top>
				<right>100</right>
				<bottom>-5%</bottom>
				<onright>$INFO[Container(901).ListItem.Property(focus)]</onright>
				<onleft>902</onleft>
				<animation effect="slide" end="-10,0" time="0" condition="!Control.HasFocus(901)">conditional</animation>
