		<!--Build Info Panel-->
			<control type="group"> 
				<include content="box">
					<param name="texture" value="box"/>
					<param name="bs" value="15,925,15,15"/>
					<param name="cd" value="box"/>
				</include>
				<control type="group">
					<top>930</top>
					<left>28</left>	
					<right>8</right>
					<!--CPU-->		
					<control type="grouplist"> 	
						<itemgap>25</itemgap>
						<orientation>vertical</orientation>
						<control type="grouplist"> 
							<itemgap>0</itemgap>
							<orientation>vertical</orientation>
							<control type="textbox">
								<top>50</top>
								<description>CPU Text</description>
								<width>auto</width>
								<height>40</height>
								<label>CPU - $INFO[System.CPUUsage]</label>
								<aligny>bottom</aligny>
								<align>left</align>
								<shadowcolor>black</shadowcolor>
								<font>font12</font>
								<visible>System.SupportsCPUUsage</visible>
								<wrapmultiline>true</wrapmultiline>
							</control>
							<control type="progress">
								<description>CPU BAR</description>
								<left>10</left>
								<right>10</right>
								<height>16</height>
								<info>System.CPUUsage</info>
								<visible>System.SupportsCPUUsage</visible>
							</control>
						</control>
					<!--RAM-->			
						<control type="grouplist"> 
							<itemgap>40</itemgap>
							<orientation>vertical</orientation>
							<control type="label">
								<description>Memory Text</description>
								<width>auto</width>
								<height>40</height>
								<label>RAM - $INFO[system.memory(used)] [B]/[/B] $INFO[system.memory(total)] [B]-[/B] $INFO[system.memory(used.percent)]</label>
								<aligny>top</aligny>
								<textoffsety>40</textoffsety>
								<shadowcolor>black</shadowcolor>
								<font>font12</font>
							</control>
							<control type="progress">
								<description>Memory BAR</description>
								<left>10</left>
								<right>10</right>
								<height>16</height>
								<info>system.memory(used)</info>
							</control>
						</control>
					</control>
				</control>
			</control>				
		</control>
	</controls>
</window>
