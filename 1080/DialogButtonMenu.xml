<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>901</defaultcontrol>
	<onload>Control.SetFocus(901, 0)</onload>
			
	<controls>
		<control type="image">
			<top>3</top>
			<left>3</left>
			<height>1074</height>
			<width>1915</width>
			<texture diffuse="diffuse/sb.png" border="16" colordiffuse="box">boxes/dbox.png</texture>
			<animation effect="zoom" start="100" end="100.5" time="5" condition="Window.IsActive(home)">conditional</animation>
			<animation effect="slide" start="0" end="-3,-3" time="0" condition="Window.IsActive(home)">Conditional</animation>
			<animation effect="fade" time="200">VisibleChange</animation>
		</control>	
		<control type="group">
			<include>OpenClose_Left</include>
			<left>0</left>
			<top>0</top>
    	    <width>618</width>
    	    <height>1080</height>	
			<control type="image">
				<posy>0</posy>
				<posx>0</posx>
				<bordersize>3,3,0,3</bordersize>
				<texture border="16" colordiffuse="button_focus">boxes/sbox.png</texture>
				<animation effect="zoom" start="100" end="100.5" time="5" condition="Window.IsActive(home)">conditional</animation>
				<animation effect="slide" start="0,0" end="-3,-3" time="0" condition="Window.IsActive(home)">Conditional</animation>
